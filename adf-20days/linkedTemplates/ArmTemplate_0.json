							"activities": [
								{
									"name": "Ingest Bronze",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "ch_landing_bronze",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"table_name": {
												"value": "@item()",
												"type": "Expression"
											},
											"run_date_values": {
												"value": "@pipeline().parameters.run_date",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					},
					{
						"name": "Customer Silver Processing",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Ingest Table",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/DataEngineering/02_silver/customer_silver_ingestion"
