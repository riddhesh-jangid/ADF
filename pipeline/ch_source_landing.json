{
	"name": "ch_source_landing",
	"properties": {
		"activities": [
			{
				"name": "Get watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'select watermark_ts from config.watermark  where table_name = ''',\n    pipeline().parameters.table_name,\n    ''''\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "src_source",
						"type": "DatasetReference",
						"parameters": {
							"table_name": "watermark"
						}
					}
				}
			},
			{
				"name": "Record count",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Get watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat(\n    'select count(*) as cnt from config.',\n    pipeline().parameters.table_name,\n    ' where ingest_ts > ''',\n    activity('Get watermark').output.firstRow.watermark_ts,\n    ''''\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "src_source",
						"type": "DatasetReference",
						"parameters": {
							"table_name": {
								"value": "@pipeline().parameters.table_name",
								"type": "Expression"
							}
						}
					}
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Record count",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Record count').output.firstRow.cnt, 0))\n",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Source to landing_copy",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderStoredProcedureName": "[config].[select_greater_than_watermark]",
									"storedProcedureParameters": {
										"table_name": {
											"type": "String",
											"value": {
												"value": "@pipeline().parameters.table_name",
												"type": "Expression"
											}
										},
										"watermark_ts": {
											"type": "DateTime",
											"value": {
												"value": "@activity('Get watermark').output.firstRow.watermark_ts",
												"type": "Expression"
											}
										}
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "src_source",
									"type": "DatasetReference",
									"parameters": {
										"table_name": "watermark"
									}
								}
							],
							"outputs": [
								{
									"referenceName": "LandingSink",
									"type": "DatasetReference",
									"parameters": {
										"directory": {
											"value": "@concat(\n  pipeline().parameters.table_name,\n  '/run_date=',\n  formatDateTime(utcNow(), 'yyyy-MM-dd')\n)",
											"type": "Expression"
										},
										"file_name": {
											"value": "@concat(\n  pipeline().parameters.table_name,\n  '_',\n  formatDateTime(utcNow(), 'yyyyMMddHHmmss'),\n  '.csv'\n)",
											"type": "Expression"
										}
									}
								}
							]
						},
						{
							"name": "Update latest watername_copy",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "Source to landing_copy",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "AzureSQL",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "NonQuery",
										"text": {
											"value": "@concat(\n    'UPDATE config.watermark SET watermark_ts = ( SELECT MAX(ingest_ts) FROM config.',\n    pipeline().parameters.table_name,\n    ' ) WHERE table_name = ''',\n    pipeline().parameters.table_name,\n    ''''\n)",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"table_name": {
				"type": "string"
			}
		},
		"annotations": []
	}
}