{
	"name": "pl_source_landing",
	"properties": {
		"activities": [
			{
				"name": "Run Tables",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Generate Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@pipeline().parameters.tables",
						"type": "Expression"
					},
					"isSequential": false,
					"activities": [
						{
							"name": "Source To Landing Child PL",
							"type": "ExecutePipeline",
							"dependsOn": [],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "ch_source_landing",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"table_name": {
										"value": "@item()",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			},
			{
				"name": "Generate Files",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/DataEngineering/__generator/Generator",
					"baseParameters": {
						"no_of_customer": "20",
						"no_of_product": "10",
						"no_of_purchase": "50"
					}
				},
				"linkedServiceName": {
					"referenceName": "20DaysDBXIC",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"tables": {
				"type": "array",
				"defaultValue": [
					"src_customer",
					"src_product"
				]
			}
		},
		"annotations": []
	}
}