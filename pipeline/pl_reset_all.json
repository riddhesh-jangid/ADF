{
	"name": "pl_reset_all",
	"properties": {
		"activities": [
			{
				"name": "call reset_all",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[config].[reset_all]"
				},
				"linkedServiceName": {
					"referenceName": "AzureSQL",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Delete All Files",
				"type": "Delete",
				"dependsOn": [
					{
						"activity": "call reset_all",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "LandingSink",
						"type": "DatasetReference",
						"parameters": {
							"directory": "src_*",
							"file_name": "*"
						}
					},
					"logStorageSettings": {
						"linkedServiceName": {
							"referenceName": "LandingLS",
							"type": "LinkedServiceReference"
						},
						"path": "landingfiles/_logging"
					},
					"enableLogging": true,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"annotations": []
	}
}